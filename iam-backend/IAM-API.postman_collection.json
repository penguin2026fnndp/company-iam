{
  "info": {
    "name": "IAM API 全链路验收（RBAC0）",
    "description": "配套 docs/04-详细设计.md。运行前：① 执行 db/reset.sql；② 启动后端（8080）；③ 按文件夹顺序运行。最后一个文件夹会锁定 SG000101 十五分钟，请放在最后。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "liToken", "value": "" },
    { "key": "mgrToken", "value": "" },
    { "key": "newUserId", "value": "" },
    { "key": "newAccount", "value": "" },
    { "key": "newRoleId", "value": "" },
    { "key": "newRoleCode", "value": "" },
    { "key": "finViewId", "value": "" },
    { "key": "finExportId", "value": "" }
