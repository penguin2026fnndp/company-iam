                  "pm.test('code=0', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "const list = pm.response.json().data;",
                  "const v = list.find(x => x.permCode === 'FIN:RPT:VIEW');",
                  "const e = list.find(x => x.permCode === 'FIN:RPT:EXPORT');",
                  "pm.collectionVariables.set('finViewId', v ? v.id : '');",
                  "pm.collectionVariables.set('finExportId', e ? e.id : '');",
                  "pm.test('找到两条 FIN 权限', () => { pm.expect(v).to.not.be.undefined; pm.expect(e).to.not.be.undefined; });"
                ]
              }
            }
          ],
          "request": {
