                  "pm.test('2 枚权限', () => pm.expect(pm.response.json().data.permissions.length).to.eql(2));",
                  "pm.collectionVariables.set('liToken', pm.response.json().data.sessionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"account\":\"SG000102\",\"password\":\"123456\"}" },
            "url": "{{baseUrl}}/api/auth/login"
