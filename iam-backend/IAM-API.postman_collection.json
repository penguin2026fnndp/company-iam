  "item": [
    {
      "name": "01 认证",
      "item": [
        {
          "name": "F01 登录（管理员）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code=0', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "pm.test('18 枚权限', () => pm.expect(pm.response.json().data.permissions.length).to.eql(18));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().data.sessionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"account\":\"SG900001\",\"password\":\"123456\"}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "F01 登录（李四）",
          "event": [
